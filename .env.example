# CodeCeremony configuration. Every setting is optional; the defaults below are
# the ones a local checkout wants. Copy to .env and adjust, or pass them through
# docker compose.

APP_ENV=development
HTTP_ADDR=:8080
ALLOWED_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
SESSION_TTL_HOURS=12

# Where the portal keeps its state: one JSON file, written atomically. Back the
# portal up by copying it, and reset it by deleting it.
DATA_DIR=./data

# The shared DOGFOOD fixture file. Seeding the portal from it means every
# entrant's portal shows the same invented hackathon, so a reviewer comparing two
# portals is comparing software rather than demo data. Leave blank to seed the
# built-in demo data instead; the portal boots either way.
FIXTURES_PATH=./fixtures.json

# How often the journal compares the in-memory state against what is on disk and
# writes if it differs. A clean shutdown always flushes, so this only bounds how
# much a hard kill can lose.
PERSIST_INTERVAL_SECONDS=2

# Seeding creates the demo events and mints fixed session tokens for the
# documented identities. Turn it off for a real deployment.
#
# The tokens are fixed, printed on every boot, and grant organizer and admin
# rights, which is correct for a self-hosted demo and indefensible in
# production. Setting APP_ENV=production therefore refuses to enable seeding
# unless SEED_PASSWORD is a private value of at least twelve characters, because
# the seeded identities all share one password.
SEED_DEMO_DATA=true
SEED_PASSWORD=codeceremony-dev

# Only used to reject a default SESSION_SECRET in production. Sessions are opaque
# random tokens stored server-side, so the secret is not a signing key and
# rotating it does not invalidate live sessions.
SESSION_SECRET=replace-with-a-long-local-development-secret

# SMTP delivery. Leave blank to use the log sink, which records messages without
# sending them, so local development and tests never need a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CodeCeremony
SMTP_ENCRYPTION=starttls

# Mail worker tuning.
MAIL_INTERVAL_SECONDS=10
MAIL_BATCH_SIZE=20
MAIL_MAX_ATTEMPTS=4

# Host port published by `docker compose up`. Change it if 8080 is taken.
CODE_CEREMONY_PORT=8080
